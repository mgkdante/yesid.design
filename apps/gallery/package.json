{
	"name": "@yesid/gallery",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Private app that renders the yesid packages and runs their browser tests.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"browser:install": "playwright install chromium",
		"test:browser": "bun run build && playwright test --config playwright.config.ts",
		"test:browser:list": "playwright test --config playwright.config.ts --list"
	},
	"dependencies": {
		"@lucide/svelte": "^1.18.0",
		"@yesid/motion": "workspace:*",
		"@yesid/tokens": "workspace:*",
		"@yesid/ui": "workspace:*"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1",
		"@playwright/test": "1.61.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.1.18",
		"@yesid/gates": "workspace:*",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
